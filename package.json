{
  "name": "kairos",
  "version": "0.1.0",
  "description": "Kairos, chronomètre de barre de menus pour Monday : lots par tâche parent et sous-tâche, piloté à la main ou par Claude. Cœur Rust, enveloppe Tauri v2, interface Angular.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "tauri": "tauri",
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tokens": "node scripts/make-tokens.cjs",
    "release": "bash scripts/release.sh",
    "build:cli": "bash scripts/build-cli.sh",
    "deploy": "bash scripts/deploy.sh",
    "verify": "node scripts/verify/tokens.cjs && node scripts/verify/theme.cjs && node scripts/verify/lang.cjs && node scripts/verify/whats-new.cjs && node scripts/verify/release.cjs && node scripts/verify/cask.cjs && node scripts/verify/bump.cjs && node scripts/verify/worker.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bump": "node scripts/bump.cjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "prettier": "^3.9.9",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.12.1",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
