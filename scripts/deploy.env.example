# Copie ce fichier vers scripts/deploy.env (non versionné) et renseigne :

# URL publique des releases, servie par le Worker Cloudflare (route
# release.lucasraffalli.com/kairos/*). Doit correspondre à l'endpoint de
# src-tauri/tauri.conf.json.
PUBLIC_URL=https://release.lucasraffalli.com/kairos

# Bucket Cloudflare R2 qui contient les fichiers (par défaut kairos-releases).
# R2_BUCKET=kairos-releases

# Clone local du tap Homebrew (défaut : ../homebrew-kairos à côté du projet)
# TAP_DIR=/chemin/vers/homebrew-kairos

# Token GitHub (scope contents:read), NÉCESSAIRE UNIQUEMENT si le dépôt passe en
# privé : sans lui, le téléchargement des artefacts de la release échoue en
# silence (404, pas 401).
# GH_TOKEN=ghp_...

# L'envoi vers R2 passe par wrangler : lance `npx wrangler login` une fois sur
# cette machine (aucun secret à mettre ici ni dans GitHub).
